# このファイルをコピーして .env という名前で保存し、値を書き換えてください。
# .env は .gitignore で除外しているので、GitHubには上がりません。

# Flaskのセッション・CSRF用の秘密の値（長いランダムな文字列）
# 作り方: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# memory: 鍵なしで動かす（データはメモリ上。止めると消える）
# sheets: Googleスプレッドシートに保存する
STORAGE=memory

# --- STORAGE=sheets のときだけ必要 ---

# スプレッドシートのURL https://docs.google.com/spreadsheets/d/<ここ>/edit の部分
SPREADSHEET_ID=

# サービスアカウント鍵。ローカルでは鍵ファイルのパスでもよい（例: service-account.json）
# Renderでは、JSONファイルの中身をそのまま貼り付ける
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- LINEとつなぐときだけ必要（README の「LINEとつなぐ」を参照） ---

# LINE Developers のチャネルの「チャネル基本設定」タブにある「チャネルシークレット」
LINE_CHANNEL_SECRET=
# 「Messaging API設定」タブのいちばん下の「チャネルアクセストークン（長期）」
LINE_CHANNEL_ACCESS_TOKEN=
# 「チャネル基本設定」タブのいちばん下の「あなたのユーザーID」（U で始まる）。この人以外の操作には反応しない
LINE_OWNER_USER_ID=
